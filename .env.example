DATABASE_URL=postgresql://user:password@localhost:5432/proyecto3
JWT_SECRET=
PORT=3001
# Comma-separated list of allowed frontend origins, or "*" for any origin.
CORS_ORIGIN=http://127.0.0.1:5174

# At least one LLM key is needed for AI rooms. Providers fail over in this order:
# Groq -> Gemini -> Mistral -> OpenRouter -> Cerebras. Leave a key empty to skip it.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
# Optional model overrides. Defaults: gemini-3.8-flash, openai/gpt-oss-20b,
# mistral-small-latest, openrouter/free, qwen-3.8-27b.
# GEMINI_MODEL=
# GROQ_MODEL=
# MISTRAL_MODEL=
# OPENROUTER_MODEL=
# CEREBRAS_MODEL=
# Per-provider timeout in milliseconds (default and maximum: 8000).
# AI_PROVIDER_TIMEOUT_MS=8000
