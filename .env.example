DATABASE_URL=postgresql://user:password@localhost:5432/proyecto3
JWT_SECRET=
PORT=3001
# Comma-separated list of allowed frontend origins, or "*" for any origin.
CORS_ORIGIN=http://127.0.0.1:5174

# At least one LLM key is needed for AI rooms. Providers fail over in this order:
# Gemini -> DeepSeek -> Grok. Leave a key empty to skip that provider.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
# Optional model overrides. Defaults: gemini-3.8-flash, deepseek-chat, grok-3-mini.
# GEMINI_MODEL=
# DEEPSEEK_MODEL=
# GROK_MODEL=
# Per-provider timeout for one AI response attempt, in milliseconds.
# AI_PROVIDER_TIMEOUT_MS=45000
